# System packages the build needs on the release and CI runners, read by
# maelys-release adopt (apt names under [linux], brew names under [macos]).
# Mbed TLS is not listed for Linux: the security floor in
# providers/mbedtls_version_policy.h is above what the distribution ships,
# so CI builds a pinned upstream commit instead.
[linux]
pkg-config
cmake
# The TLS integration test signs a throwaway certificate with the openssl
# command and serves it from tests/https_server.py; generate-sbom.sh formats
# the SBOM's creation time and validates its JSON with python3. The runner
# images happen to carry both, which is why nothing failed until a bare
# ubuntu:26.04 rehearsal of linux-arm64 said python3: not found.
python3
openssl
[macos]
pkg-config
mbedtls
