prefix=@PREFIX@
includedir=${prefix}/include
libdir=${prefix}/lib

Name: maelys-http-tls-mbedtls
Description: Optional Mbed TLS client provider for Maelys HTTP
Version: @VERSION@
Requires.private: mbedtls >= @MBEDTLS_MIN_VERSION@, mbedx509 >= @MBEDTLS_MIN_VERSION@, mbedcrypto >= @MBEDTLS_MIN_VERSION@@MBEDTLS_UPPER@
Libs: -L${libdir} -lmaelys_http_tls_mbedtls -lmaelys_http
Libs.private: -pthread
Cflags: -I${includedir}
